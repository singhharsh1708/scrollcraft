# ─────────────────────────────────────────────────────────────
# ScrollCraft environment variables
# Copy this file to `.env` and fill in the values you need.
# Only DATABASE_URL and NEXTAUTH_SECRET are required to run locally.
# ─────────────────────────────────────────────────────────────

# Database (required) — PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/scrollcraft"

# Auth — NextAuth v5 uses AUTH_SECRET (NEXTAUTH_SECRET is the v4 alias, both work)
# Generate with: openssl rand -base64 32
# In Vercel: add AUTH_SECRET under Settings → Environment Variables
AUTH_SECRET=""
# Set to your production URL in Vercel (required for OAuth callbacks to work)
# e.g. AUTH_URL="https://scrollcraft.app"
AUTH_URL="http://localhost:3000"
# Legacy aliases (still accepted by NextAuth v5)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional — enables GitHub / Google sign-in)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI video generation (optional — without these, the app runs in demo mode)
LUMAAI_API_KEY=""
RUNWAYML_API_KEY=""

# AI chat editing (optional)
ANTHROPIC_API_KEY=""

# Asset storage (optional — Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Payments — Razorpay (subscriptions, INR)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Payments — Lemon Squeezy (one-time export purchases, global)
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Rate limiting (optional — Upstash Redis; falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error monitoring (optional — Sentry)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_TRACES_SAMPLE_RATE="0.5"

# Database connection pool size (optional)
DB_POOL_MAX="5"
