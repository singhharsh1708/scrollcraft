# ─────────────────────────────────────────────────────────────
# ScrollCraft environment variables
#
# Every one of these is optional. ScrollCraft keeps no accounts and no
# server-side state, so it runs with this file empty — or absent entirely:
#
#   npm install && npm run dev
#
# ─────────────────────────────────────────────────────────────

# Public origin, used for robots.txt, the sitemap and canonical URLs.
# Only worth setting on a real deployment.
SITE_URL=""

# Rate limiting for the export route, the only one that takes a request body.
# Without these the limiter falls back to an in-memory store, which is correct
# for a single instance and fine locally.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Reads back the daily counts of editor opens, first edits and exports at
# GET /api/count, with "Authorization: Bearer <token>". Without it that route
# answers 404 and the counts are still written, just not readable over HTTP.
FUNNEL_TOKEN=""

# Error reporting. Leave empty to disable it entirely.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""

# The editor's assistant, which rewrites sections from a plain-language instruction.
# Without a key the assistant is not offered at all. Get one at dashboard.sarvam.ai.
SARVAM_API_KEY=""
# Defaults to sarvam-105b. The -conversations variant has a smaller context window.
SARVAM_MODEL=""
# Optional. Any endpoint that speaks the OpenAI chat-completions shape.
# Defaults to https://api.sarvam.ai/v1.
SARVAM_BASE_URL=""

# Writing a site from a description, at /describe. Without a key that page's button
# answers 503 and nothing is offered. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=""
# Sites the whole deployment will write in a day, across everybody. Defaults to 150.
GENERATE_DAILY_LIMIT=""

# Selling packs of five generations through Lemon Squeezy. Without the secret the webhook
# answers 503 and the pricing page says the shop is not open, which is what a fork wants.
# The secret is the one you typed into the webhook form: 6 to 40 characters.
LEMONSQUEEZY_WEBHOOK_SECRET=""
# The hosted checkout URL for the pack, as https://STORE.lemonsqueezy.com/checkout/buy/VARIANT.
NEXT_PUBLIC_LEMON_CHECKOUT_URL=""
# Set to 1 only on a deployment that should honour test mode purchases.
LEMONSQUEEZY_ACCEPT_TEST_MODE=""

# Sign in with Google or GitHub, so a buyer's credits reach them in any browser. Sign-in
# is offered when AUTH_SECRET and at least one provider's pair are set; without them
# there is no sign-in button and credits stay on the licence-key cookie. Generate the
# secret with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""
# Google: create an OAuth client ID (Web application) in Google Cloud Console with the
# authorised redirect URI <origin>/api/auth/callback/google.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# GitHub: register an OAuth app at github.com/settings/developers with the callback
# <origin>/api/auth/callback/github.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Selling packs through Stripe. Buyers must be signed in, so this needs AUTH_SECRET
# and a sign-in provider as well. Without the key the checkout answers 503 and no Buy button
# is offered. STRIPE_PRICE_ID is optional: left empty, the price is found by its lookup
# key, five_sites_usd, which lets the same code run against a test and a live account.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Selling packs through Dodo Payments, the merchant of record. Takes precedence over Stripe
# when both are set, and needs sign-in configured too. Test and live mode each have
# their own API key, product and webhook endpoint.
DODO_PAYMENTS_API_KEY=""
# Signing secret of the endpoint <origin>/api/dodo/webhook, subscribed to
# payment.succeeded and refund.succeeded.
DODO_PAYMENTS_WEBHOOK_KEY=""
# test_mode (the default) or live_mode.
DODO_PAYMENTS_ENVIRONMENT=""
# The one-time $20 USD product for a pack of five, pdt_...
DODO_PRODUCT_ID=""
