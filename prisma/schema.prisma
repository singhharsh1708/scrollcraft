generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Written by the Auth.js adapter on every account creation, so the column must exist
  // even though nothing in the app reads it.
  emailVerified DateTime?
  name      String?
  image     String?
  plan      Plan     @default(FREE)
  // When the current paid plan lapses. Null means no expiry (a legacy grant, or FREE);
  // a paid plan past this date is treated as FREE and lazily downgraded.
  planExpiresAt DateTime?
  credits   Int      @default(100)
  // AI design-change chats consumed in the current period, and when that period began.
  // Metered separately from `credits`, which covers image/video generation.
  chatEditsUsed   Int      @default(0)
  chatPeriodStart DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites           Site[]
  payments        Payment[]
  exportPurchases ExportPurchase[]
  accounts        Account[]
  sessions        Session[]
}

model Site {
  id           String   @id @default(cuid())
  userId       String
  name         String   @default("My ScrollCraft Site")
  fps          Int      @default(24)
  frameCount   Int      @default(0)
  framesJson   String?  @db.Text
  sectionsJson String?  @db.Text
  // Theme (fonts, type scale, palette) and background recipe (style + colours), stored as
  // data so the published page and the exporter can recompile them instead of needing the
  // multi-megabyte frame set that never reaches the server.
  themeJson    String?  @db.Text
  styleJson    String?
  customHead   String?  @db.Text
  customCss    String?  @db.Text
  audioUrl     String?
  published    Boolean  @default(false)
  publishSlug  String?  @unique
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exportPurchases ExportPurchase[]

  @@index([userId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  plan              String
  billing           String
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  promoCode         String?
  discountPct       Int?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ExportPurchase {
  id          String              @id @default(cuid())
  userId      String
  siteId      String
  lsOrderId   String              @unique
  lsCheckoutId String?
  amount      Int
  currency    String              @default("USD")
  status      ExportPurchaseStatus @default(PENDING)
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a site must not erase the record of money taken for
  // it — that record is what a refund or chargeback is reconciled against.
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([siteId])
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Int
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Plan {
  FREE
  BASIC
  BASIC_PLUS
  PRO
  PREMIUM
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum ExportPurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// A revocation can arrive before the order_created it revokes: Lemon Squeezy does not
// guarantee delivery order, and a retry can reorder them further. ExportPurchase needs
// userId/siteId foreign keys, which a refund payload does not carry, so the revocation
// cannot create that row itself. This table records the revocation with no foreign keys
// so a later order_created can be refused instead of granting access to a refunded order.
model RevokedLsOrder {
  lsOrderId String   @id
  eventName String
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
