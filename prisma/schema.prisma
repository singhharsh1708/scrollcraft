generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  plan      Plan     @default(FREE)
  credits   Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites           Site[]
  payments        Payment[]
  exportPurchases ExportPurchase[]
  accounts        Account[]
  sessions        Session[]
}

model Site {
  id           String   @id @default(cuid())
  userId       String
  name         String   @default("My ScrollCraft Site")
  fps          Int      @default(24)
  frameCount   Int      @default(0)
  framesJson   String?  @db.Text
  sectionsJson String?  @db.Text
  customHead   String?  @db.Text
  customCss    String?  @db.Text
  audioUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exportPurchases ExportPurchase[]

  @@index([userId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  plan              String
  billing           String
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  promoCode         String?
  discountPct       Int?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ExportPurchase {
  id          String              @id @default(cuid())
  userId      String
  siteId      String
  lsOrderId   String              @unique
  lsCheckoutId String?
  amount      Int
  currency    String              @default("USD")
  status      ExportPurchaseStatus @default(PENDING)
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([siteId])
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Int
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Plan {
  FREE
  BASIC
  BASIC_PLUS
  PRO
  PREMIUM
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum ExportPurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
